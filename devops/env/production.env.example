# Template for the droplet's /opt/backflip/.env — infra + runtime config.
# Upload with `./devops/deploy.sh --env <this file, filled in>` or copy it manually.
# Never commit the filled-in version.
# @spec L2-DEVOPS-06

POSTGRES_USER=backflip
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=backflip

# DATABASE_URL is NOT set here — compose derives it from the vars above and
# points the app at `db:5432` on the internal network.

# Secret-at-rest key — encrypts stored secrets (AI provider API keys).
# Generate with `openssl rand -base64 32`.
ENCRYPTION_KEY=change-me

# Public domain served by Caddy. Needs a DNS A record → droplet IP.
DOMAIN=example.com
