{
  "name": "backflip",
  "version": "1.12.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/track-start.mjs & turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "version:check": "node scripts/check-version.mjs",
    "semantic-release": "semantic-release",
    "init-owner": "yarn workspace @workspace/db init-owner",
    "db:generate": "yarn workspace @workspace/db db:generate",
    "db:migrate": "yarn workspace @workspace/db db:migrate",
    "db:studio": "yarn workspace @workspace/db db:studio"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "semantic-release": "^25.0.9",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
