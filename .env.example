# Copy to .env for local development (`.env` is gitignored).
# Postgres runs in Docker (see docker-compose.yml). These values seed that container
# AND are read by the locally-run app.

POSTGRES_USER=backflip
POSTGRES_PASSWORD=backflip_local_dev
POSTGRES_DB=backflip
# Host port for the dockerized postgres (kept off the default 5432 to avoid clashes).
POSTGRES_PORT=5544

# App → db connection.
# Local app (yarn dev): db reached on localhost:${POSTGRES_PORT}.
DATABASE_URL=postgres://backflip:backflip_local_dev@localhost:5544/backflip

# --- Admin owner seed ---
# Do NOT put these here. They live in `.env.local` (gitignored), consumed by
# `corepack yarn init-owner`:
#   ADMIN_EMAIL=you@example.com
#   ADMIN_PASSWORD=<a strong random string>
